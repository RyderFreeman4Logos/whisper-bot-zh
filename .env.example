# ==============================================
# Core Bot Configuration
# ==============================================
BOT_TOKEN=your_telegram_bot_token_here
ACCESS_PASSWORD=change_me_to_a_strong_password
LOG_LEVEL=INFO
# Optional Proxy (e.g., http://127.0.0.1:7890)
# PROXY_URL=

# Max concurrent transcription requests (API is fast; usually 1 is fine).
MAX_CONCURRENT_TASKS=1

# ==============================================
# ASR (OpenAI-compatible transcription endpoint)
# ==============================================
# Defaults point at Groq's hosted Whisper (no GPU required).
# To use a self-hosted OpenAI-compatible server (whisper.cpp, vLLM-whisper,
# etc.), override ASR_BASE_URL / ASR_API_KEY / ASR_MODEL below.
ASR_BASE_URL=https://api.groq.com/openai/v1
# Credential. If unset, falls back to GROQ_API_KEY or OPENAI_API_KEY env var.
# ASR_API_KEY=
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=zh
# Prompt biases the model toward simplified Chinese output.
ASR_PROMPT=以下是一段简体中文内容:
# 0.0 = deterministic. Raise slightly if the model refuses to commit on noisy audio.
ASR_TEMPERATURE=0.0

# ==============================================
# LLM Post-Processing Configuration (Optional)
# ==============================================
# Comma-separated list of models for fallback strategy.
# Example: Try Groq 70B first, then Groq 8B, then Gemini Flash as backup.
# Supported providers: gemini/*, groq/*, anthropic/*, deepseek/*, etc.
LLM_MODEL=groq/llama-3.3-70b-versatile,groq/llama-3.1-8b-instant,gemini/gemini-2.0-flash-exp

# System prompt for the LLM editor. Defaults to a strict "no commentary / no
# trailing suggestions" prompt defined in config.py — override only if you
# want different behavior.
# LLM_SYSTEM_PROMPT=

# Sampling knobs. Lower temperature = more faithful, less creative rewriting.
LLM_TEMPERATURE=0.2
# LLM_TOP_P=0.9
# LLM_MAX_TOKENS=4096

# ==============================================
# LLM API Keys
# ==============================================
# Configure keys for the providers used in LLM_MODEL
GEMINI_API=your_gemini_api_key
GROQ_API=your_groq_api_key
ANTHROPIC_API=your_anthropic_api_key
# XAI_API=
# ZENMUX_API=

# ==============================================
# Custom Paths (Optional)
# ==============================================
# Defaults to XDG paths (~/.config/whisper-bot-zh, ~/.cache/whisper-bot-zh)
# DATA_DIR=/path/to/data
