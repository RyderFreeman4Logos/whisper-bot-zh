# ==============================================
# Core Bot Configuration
# ==============================================
BOT_TOKEN=your_telegram_bot_token_here
ACCESS_PASSWORD=change_me_to_a_strong_password
LOG_LEVEL=INFO
# Optional Proxy (e.g., http://127.0.0.1:7890)
# PROXY_URL=

# ==============================================
# Whisper ASR Configuration
# ==============================================
# Model size: tiny, base, small, medium, large-v1, large-v2, large-v3
WHISPER_MODEL_SIZE=large-v2
# Compute type: int8 (recommended for <8GB VRAM), float16, float32
WHISPER_COMPUTE_TYPE=int8
# VAD Filter: True to filter silence (recommended)
WHISPER_VAD_FILTER=True
# Initial prompt to guide the model (e.g. force Simplified Chinese)
WHISPER_INITIAL_PROMPT=以下是一段简体中文内容:
MAX_CONCURRENT_TASKS=1

# ==============================================
# LLM Post-Processing Configuration (Optional)
# ==============================================
# Comma-separated list of models for fallback strategy.
# Example: Try Groq 70B first, then Groq 8B, then Gemini Flash as backup.
# Supported providers: gemini/*, groq/*, anthropic/*, deepseek/*, etc.
LLM_MODEL=groq/llama-3.3-70b-versatile,groq/llama-3.1-8b-instant,gemini/gemini-2.0-flash-exp

# System prompt for the LLM editor
LLM_SYSTEM_PROMPT=你是一位精通中文的专业编辑。你的任务是接收一段语音转录的粗糙文本，对其进行润色。请执行以下操作：1. 修正错别字和明显的语音识别错误。2. 添加正确的标点符号。3. 根据语义进行合理的分段。4. 保持原意，不要删减关键信息。

# ==============================================
# LLM API Keys
# ==============================================
# Configure keys for the providers used in LLM_MODEL
GEMINI_API=your_gemini_api_key
GROQ_API=your_groq_api_key
ANTHROPIC_API=your_anthropic_api_key
# XAI_API=
# ZENMUX_API=

# ==============================================
# Custom Paths (Optional)
# ==============================================
# If not set, defaults to XDG paths (~/.config/whisper-bot-zh, ~/.cache/whisper-bot-zh)
# MODEL_DIR=/path/to/custom/models
# DATA_DIR=/path/to/custom/data